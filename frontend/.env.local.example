# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Spotify OAuth ─────────────────────────────────────────
AUTH_SPOTIFY_ID=your-spotify-client-id
AUTH_SPOTIFY_SECRET=your-spotify-client-secret

# ── Google OAuth (YouTube Music) ─────────────────────────────
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ── Auth.js ───────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=your-auth-secret
AUTH_URL=http://127.0.0.1:3000
AUTH_TRUST_HOST=true

# ── Public (exposed to client bundle) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── Encryption (server-side only) ─────────────────────────
# Generate a 32-byte hex string (e.g., using `openssl rand -hex 32`)
ENCRYPTION_KEY=your-encryption-key-hex-string
